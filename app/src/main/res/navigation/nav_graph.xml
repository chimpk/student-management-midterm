<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard">

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.example.studentmgmt.ui.dashboard.DashboardFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/nav_student_list"
        android:name="com.example.studentmgmt.ui.student.StudentListFragment"
        android:label="@string/title_students"
        tools:layout="@layout/fragment_student_list" />

    <fragment
        android:id="@+id/nav_student_detail"
        android:name="com.example.studentmgmt.ui.student.StudentDetailFragment"
        android:label="@string/title_student_detail"
        tools:layout="@layout/fragment_student_detail" />

    <fragment
        android:id="@+id/nav_user_management"
        android:name="com.example.studentmgmt.ui.user.UserListFragment"
        android:label="@string/title_users"
        tools:layout="@layout/fragment_user_list" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.studentmgmt.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/nav_login_history"
        android:name="com.example.studentmgmt.ui.history.LoginHistoryFragment"
        android:label="@string/title_login_history"
        tools:layout="@layout/fragment_login_history" />

    <fragment
        android:id="@+id/nav_import_export"
        android:name="com.example.studentmgmt.ui.data.ImportExportFragment"
        android:label="@string/title_import_export"
        tools:layout="@layout/fragment_import_export" />

</navigation>
