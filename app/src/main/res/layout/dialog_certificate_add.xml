<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    
    xmlns:android="http://schemas.android.com/apk/res/android"
    
    xmlns:app="http://schemas.android.com/apk/res-auto"
    
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">
    <TextView
        android:id="@+id/tvCertDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/title_add_certificate"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />
    <TextView
        android:id="@+id/tvCertStudentBinding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/color_primary"
        android:textSize="12sp"
        tools:text="Gắn với MSSV: 524H0001" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/form_required_note"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />
    <!-- Tên chứng chỉ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cert_name"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/label_certificate_name"
        app:boxCornerRadiusBottomEnd="@dimen/radius_input"
        app:boxCornerRadiusBottomStart="@dimen/radius_input"
        app:boxCornerRadiusTopEnd="@dimen/radius_input"
        app:boxCornerRadiusTopStart="@dimen/radius_input"
        app:startIconDrawable="@drawable/ic_school"
        app:startIconTint="@color/text_secondary">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cert_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subtitle" />
    </com.google.android.material.textfield.TextInputLayout>
        <!-- Đơn vị cấp -->
        <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cert_issuer"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/label_issuer"
        app:boxCornerRadiusBottomEnd="@dimen/radius_input"
        app:boxCornerRadiusBottomStart="@dimen/radius_input"
        app:boxCornerRadiusTopEnd="@dimen/radius_input"
        app:boxCornerRadiusTopStart="@dimen/radius_input"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconTint="@color/text_secondary">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cert_issuer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subtitle" />
    </com.google.android.material.textfield.TextInputLayout>
            <!-- Ngày cấp -->
            <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_cert_date"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/label_issue_date"
        app:boxCornerRadiusBottomEnd="@dimen/radius_input"
        app:boxCornerRadiusBottomStart="@dimen/radius_input"
        app:boxCornerRadiusTopEnd="@dimen/radius_input"
        app:boxCornerRadiusTopStart="@dimen/radius_input"
        app:endIconDrawable="@drawable/ic_calendar"
        app:endIconMode="custom"
        app:endIconTint="@color/color_primary"
        app:startIconDrawable="@drawable/ic_calendar"
        app:startIconTint="@color/text_secondary">
                <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_cert_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:inputType="none"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subtitle" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- Action buttons -->
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_cert"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/min_touch_target"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary" />
                <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_cert"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/min_touch_target"
            android:text="@string/btn_save"
            android:textColor="@color/color_on_primary"
            app:backgroundTint="@color/color_primary"
            app:cornerRadius="@dimen/radius_input" />
            </LinearLayout>
        </LinearLayout>
