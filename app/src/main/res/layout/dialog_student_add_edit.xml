<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    
    xmlns:android="http://schemas.android.com/apk/res/android"
    
    xmlns:app="http://schemas.android.com/apk/res-auto"
    
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/title_add_student"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/tvDialogSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle_add_student"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_subtitle" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/form_required_note"
            android:textColor="@color/color_primary"
            android:textSize="12sp" />
        <!-- Field MSSV -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_student_id"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/field_mssv_required"
            app:boxCornerRadiusBottomEnd="@dimen/radius_input"
            app:boxCornerRadiusBottomStart="@dimen/radius_input"
            app:boxCornerRadiusTopEnd="@dimen/radius_input"
            app:boxCornerRadiusTopStart="@dimen/radius_input"
            app:startIconDrawable="@drawable/ic_school"
            app:startIconTint="@color/text_secondary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_student_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle" />
        </com.google.android.material.textfield.TextInputLayout>
        <!-- Immutable MSSV note (S06 / S32) -->
        <TextView
            android:id="@+id/tvMssvImmutableNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/note_mssv_immutable"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />
        <!-- Field Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_student_name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/field_name_required"
            app:boxCornerRadiusBottomEnd="@dimen/radius_input"
            app:boxCornerRadiusBottomStart="@dimen/radius_input"
            app:boxCornerRadiusTopEnd="@dimen/radius_input"
            app:boxCornerRadiusTopStart="@dimen/radius_input"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="@color/text_secondary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_student_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle" />
        </com.google.android.material.textfield.TextInputLayout>
            <!-- Field Date of Birth (DatePicker S19) -->
            <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_student_dob"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/field_dob_required"
            app:boxCornerRadiusBottomEnd="@dimen/radius_input"
            app:boxCornerRadiusBottomStart="@dimen/radius_input"
            app:boxCornerRadiusTopEnd="@dimen/radius_input"
            app:boxCornerRadiusTopStart="@dimen/radius_input"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom"
            app:endIconTint="@color/color_primary"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="@color/text_secondary">
                <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_student_dob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- Field Class -->
            <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_student_class"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/field_class_required"
            app:boxCornerRadiusBottomEnd="@dimen/radius_input"
            app:boxCornerRadiusBottomStart="@dimen/radius_input"
            app:boxCornerRadiusTopEnd="@dimen/radius_input"
            app:boxCornerRadiusTopStart="@dimen/radius_input"
            app:startIconDrawable="@drawable/ic_people"
            app:startIconTint="@color/text_secondary">
                <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_student_class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- Field Faculty -->
            <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_student_faculty"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/field_faculty_required"
            app:boxCornerRadiusBottomEnd="@dimen/radius_input"
            app:boxCornerRadiusBottomStart="@dimen/radius_input"
            app:boxCornerRadiusTopEnd="@dimen/radius_input"
            app:boxCornerRadiusTopStart="@dimen/radius_input"
            app:startIconDrawable="@drawable/ic_school"
            app:startIconTint="@color/text_secondary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_student_faculty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle" />
        </com.google.android.material.textfield.TextInputLayout>
                <!-- Field Email -->
                <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_student_email"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/field_email_required"
            app:boxCornerRadiusBottomEnd="@dimen/radius_input"
            app:boxCornerRadiusBottomStart="@dimen/radius_input"
            app:boxCornerRadiusTopEnd="@dimen/radius_input"
            app:boxCornerRadiusTopStart="@dimen/radius_input"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="@color/text_secondary">
                    <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_student_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle" />
                </com.google.android.material.textfield.TextInputLayout>
                <!-- Status / Certificate Note -->
                <TextView
            android:id="@+id/tvStudentStatusNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/note_new_student_status"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
                <!-- Action Buttons -->
                <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelStudent"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_secondary" />
                    <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveStudent"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/min_touch_target"
                android:text="@string/btn_save"
                android:textColor="@color/color_on_primary"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="@dimen/radius_input" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
