<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarUserList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarUserList"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationContentDescription="@string/nav_back"
            app:title="@string/title_users"
            app:titleTextColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_user_mgmt_desc"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvUserCountSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                tools:text="3 tài khoản · 2 đang hoạt động" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Offline Banner (S74) -->
        <include
            android:id="@+id/includeOfflineBanner"
            layout="@layout/view_offline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Skeleton loading (S71) -->
            <include
                android:id="@+id/includeLoadingSkeleton"
                layout="@layout/view_loading_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Empty state (S72) -->
            <include
                android:id="@+id/includeEmptyState"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Error state (S73) -->
            <include
                android:id="@+id/includeErrorState"
                layout="@layout/view_error_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- User list (S10 / S33) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_users"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="88dp"
                tools:listitem="@layout/item_user" />

            <!-- Legacy fallback views to maintain full backward compatibility -->
            <TextView
                android:id="@+id/tv_empty_users"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_error_users"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <TextView android:id="@+id/tv_error_users" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Button android:id="@+id/btn_retry_users" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </FrameLayout>
    </LinearLayout>

    <!-- FAB Add User (S10 / S40) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/btn_add_user"
        android:text="@string/btn_add_user"
        android:textColor="@color/color_on_primary"
        app:backgroundTint="@color/color_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/color_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
