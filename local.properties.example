## This file is an example of local.properties.
## Copy this file to 'local.properties' and set your actual Android SDK path:
## Windows example:
# sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk
## macOS example:
# sdk.dir=/Users/YourUsername/Library/Android/sdk
## Linux example:
# sdk.dir=/home/YourUsername/Android/Sdk
