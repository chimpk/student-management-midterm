rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Note: Cross-service lookup to Cloud Firestore requires IAM permissions
    // between Firebase Storage and Cloud Firestore services when deployed.
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    // Fail-closed: User document must exist, have status 'Normal', and role in admin|manager|employee.
    // Locked or missing users are strictly denied storage operations.
    function isActiveUser() {
      return userExists()
        && userDoc().data.status == 'Normal'
        && userDoc().data.role in ['admin', 'manager', 'employee'];
    }

    function isAvatarOwner(fileName) {
      return fileName == request.auth.uid + '.jpg'
        || fileName == request.auth.uid + '.jpeg'
        || fileName == request.auth.uid + '.png';
    }

    function validAvatarFile() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png'];
    }

    match /avatars/{fileName} {
      allow read: if isActiveUser();

      allow create, update: if isActiveUser()
        && isAvatarOwner(fileName)
        && validAvatarFile();

      allow delete: if isActiveUser()
        && isAvatarOwner(fileName);
    }
  }
}
