rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && currentUser().data.role == 'admin';
    }

    function isManagerOrAdmin() {
      return signedIn()
        && currentUser().data.role in ['admin', 'manager'];
    }

    function validUser(userId) {
      return request.resource.data.keys().hasAll([
          'uid', 'username', 'name', 'age', 'phone',
          'status', 'role', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'email', 'name', 'age', 'phone',
          'status', 'role', 'avatarUrl', 'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 128
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z][a-z0-9._-]{2,31}$')
        && (!('email' in request.resource.data)
          || (request.resource.data.email is string
            && request.resource.data.email.size() >= 3
            && request.resource.data.email.size() <= 254
            && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 60
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^0[0-9]{9}$')
        && request.resource.data.status in ['Normal', 'Locked']
        && request.resource.data.role in ['admin', 'manager', 'employee']
        && (!('avatarUrl' in request.resource.data)
          || (request.resource.data.avatarUrl is string
            && request.resource.data.avatarUrl.size() <= 2048))
        && request.resource.data.createdAt is timestamp;
    }

    function validStudent(studentId) {
      return request.resource.data.keys().hasAll([
          'studentId', 'name', 'dateOfBirth',
          'className', 'faculty', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'name', 'dateOfBirth',
          'className', 'faculty', 'createdAt'
        ])
        && request.resource.data.studentId == studentId
        && request.resource.data.studentId is string
        && request.resource.data.studentId.matches(
          '^[0-9A-H][0-9]{2}[0H][0-9]{4}$'
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.className is string
        && request.resource.data.className.matches('^[0-9A-Z]{8}$')
        && request.resource.data.faculty is string
        && request.resource.data.faculty.size() >= 2
        && request.resource.data.faculty.size() <= 100
        && request.resource.data.createdAt is timestamp;
    }

    function validCertificate() {
      return request.resource.data.keys()
          .hasAll(['certName', 'issueDate', 'issuedBy'])
        && request.resource.data.keys()
          .hasOnly(['certName', 'issueDate', 'issuedBy'])
        && request.resource.data.certName is string
        && request.resource.data.certName.size() >= 2
        && request.resource.data.certName.size() <= 100
        && request.resource.data.issueDate is string
        && request.resource.data.issueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.issuedBy is string
        && request.resource.data.issuedBy.size() >= 2
        && request.resource.data.issuedBy.size() <= 100;
    }

    function validLoginHistory() {
      return request.resource.data.keys().hasAll(['timestamp'])
        && request.resource.data.keys().hasOnly(['timestamp', 'device'])
        && request.resource.data.timestamp is timestamp
        && (!('device' in request.resource.data)
          || (request.resource.data.device is string
            && request.resource.data.device.size() <= 200));
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() && validUser(userId);
      allow update: if (isAdmin()
          && validUser(userId)
          && request.resource.data.createdAt == resource.data.createdAt)
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['avatarUrl'])
          && request.resource.data.avatarUrl is string
          && request.resource.data.avatarUrl.size() <= 2048);
      allow delete: if isAdmin();

      match /loginHistory/{logId} {
        allow read: if signedIn()
          && (request.auth.uid == userId || isAdmin());
        allow create: if signedIn()
          && request.auth.uid == userId
          && validLoginHistory();
        allow update: if isAdmin() && validLoginHistory();
        allow delete: if isAdmin();
      }
    }

    match /students/{studentId} {
      allow read: if signedIn();
      allow create: if isManagerOrAdmin() && validStudent(studentId);
      allow update: if isManagerOrAdmin()
        && validStudent(studentId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isManagerOrAdmin();

      match /certificates/{certId} {
        allow read: if signedIn();
        allow create, update: if isManagerOrAdmin()
          && validCertificate();
        allow delete: if isManagerOrAdmin();
      }
    }
  }
}
